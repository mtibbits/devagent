#!/usr/bin/env bash
# Verb-aware stub `gh` for tests (#90). It asserts the subcommand and required
# flags and returns per-case payloads, so a wrong subcommand/flag/repo in a
# backend exits non-zero (exit 3) — the regression net for the §9 github
# contract suite. Wrong invocations no longer pass silently.
#
# Knobs (unchanged from the pre-#90 stub):
#   GH_STUB_CASE   standard | nocomments | fail | noisy   (issue-view payload)
#   GH_STUB_CREATE_URL   URL printed by `gh issue create` (default …/issues/85)
#   GH_STUB_ARGS_LOG     if set, `gh issue create` appends its argv here (#89)
#   GH_STUB_BODY_JSON     if set, issue-view body — a JSON-encoded STRING (#537)
#   GH_STUB_COMMENTS_JSON if set, issue-view comments — a JSON array (#537)
#   GH_STUB_LABELS_JSON   if set, issue-view labels — a JSON array (#561)
#   GH_STUB_ISSUE_STATE   issue-view state (#885; default OPEN)
#   GH_STUB_STATE_REASON  issue-view stateReason, e.g. COMPLETED (#885;
#                         default null)
#   GH_STUB_ISSUE_LIST_FILE  `gh issue list` payload file (#703; required —
#                            this stub is copied out of the fixtures dir)
#   GH_STUB_GRAPHQL_DIR   `gh api graphql` responses (#704): the k-th call
#                         serves <dir>/<k>.json, writes <dir>/<k>.err to
#                         stderr and exits with <dir>/<k>.rc (else 0). A
#                         missing <k>.json is a stub assertion failure (exit
#                         3), so an extra call fails its test; a suite that
#                         reaches the #704 MR phase with a github code
#                         backend and no responses gets one MR WARNING.
#   GH_STUB_GRAPHQL_COUNT the call counter file (default <dir>/count). Each
#                         call also appends its bracketed argv to
#                         $GH_STUB_ARGS_LOG when that is set.
#   GH_STUB_ARGV_LOG      if set, `issue view`, `issue edit` and `label list`
#                         append their argv here, one bracketed element per
#                         word (#710), e.g.
#                         [issue] [edit] [1] [--repo] [acme/x] [--add-label] [In Review]
#                         so a multi-word label cannot read as two words.
#   GH_STUB_REPO_LABELS   `gh label list` payload, a JSON array of {"name": …}
#                         (#710; default []). gh's --search is fuzzy, so the
#                         stub answers with every label and the caller matches.
#   GH_STUB_LABEL_LIST_FAIL=1  `gh label list` fails as gh does on HTTP 401
#   GH_STUB_EDIT_FAIL=<code>   `gh issue edit` fails with `HTTP <code>` (#710)
#   GH_STUB_PR_CHECKS_FILE  `gh pr view --json headRefOid,state,statusCheckRollup`
#                         payload file (#782; required when that call is made)
#   GH_STUB_PR_CHECKS_LOG  if set, that call appends `pr-checks` here, so a
#                         "no read" leg can assert the file is absent
#   GH_STUB_PR_CHECKS_SLEEP=<n>  that call execs `sleep <n>` (a hung forge)
#   GH_STUB_PR_CHECKS_RC=<rc>    that call prints `stub: forced failure` to
#                         stderr and exits <rc> (0/unset = serve the file)
#   GH_STUB_PR_VIEW_FILE  `gh pr view` payload for code/github.sh mr-view's
#                         selection (#885; required when that call is made).
#                         Its GraphQL call is served by GH_STUB_GRAPHQL_DIR.
#   GH_STUB_PR_MERGE_LOG  if set, `gh pr merge` appends its argv here, one
#                         bracketed element per word as GH_STUB_ARGV_LOG does
#                         (so `[--body] []` differs from no --body), then a
#                         line `GH_PROMPT_DISABLED=<v> stdin=<tty|notty>`
#   GH_STUB_PR_MERGE_RC=<rc>   `gh pr merge` exits <rc> (default 0); non-zero
#                         prints $GH_STUB_PR_MERGE_ERR (default
#                         `stub: forced merge failure`) to stderr
#   GH_STUB_EVENTS_DIR    the #712 new-verb REST paths (repos/<o>/<r>/issues/<n>/
#                         events and …/comments, and `user`): unset, each is a
#                         stub assertion failure (exit 3, the trust-off
#                         tripwire); set, serves <dir>/{events,comments,user}.json,
#                         writes the sibling .err to stderr and exits the
#                         sibling .rc (default 0) after printing. events and
#                         comments must carry --paginate.
#
# `gh api` and `gh api graphql` append their argv to GH_STUB_ARGV_LOG as
# `issue view` does, plus a trailing `GH_HOST=<value>` (`GH_HOST=<unset>` when
# unset) (#712). Any other REST path is a stub assertion failure (exit 3).
#
# #561: the DEFAULT label set below (`bug`, `performance`) is deliberately
# non-`tier:*`-shaped. pull.sh's label channel classifies only `tier:*` labels
# and silently ignores the rest, so every suite that loads this stub stays green
# without opting in. Changing either default to a `tier:*` name would inject
# warns (or dies) into every one of those suites — pick a non-`tier:` name.
#
# Contract-suite HTTP simulation (number-driven, used by backend-github.bats):
#   issue number 404 → "HTTP 404" on stderr, exit 1
#   issue number 401 → "HTTP 401" on stderr, exit 1

set -u

# exit 3 = stub assertion failure (distinct from a simulated gh failure, exit 1).
_assert_fail() { echo "stub-gh: $*" >&2; exit 3; }

_has_flag() {
  # _has_flag <flag> -- "$@"  → 0 if <flag> appears as a standalone arg
  local want="$1"; shift; shift
  local a
  for a in "$@"; do [ "$a" = "$want" ] && return 0; done
  return 1
}

_argv_log() {
  # #710: one bracketed element per argv word, appended to GH_STUB_ARGV_LOG.
  [ -n "${GH_STUB_ARGV_LOG:-}" ] || return 0
  local line="" a
  for a in "$@"; do line+="[$a] "; done
  printf '%s%s\n' "${line% }" "${_ARGV_LOG_SUFFIX:-}" >> "$GH_STUB_ARGV_LOG"
}

_api_log() {
  # #712: _argv_log plus the GH_HOST the call ran under.
  local host="<unset>"
  [ -n "${GH_HOST+x}" ] && host="$GH_HOST"
  _ARGV_LOG_SUFFIX=" GH_HOST=$host" _argv_log "$@"
}

_api_path() {
  # _api_path "$@" → the REST path: the first word after `api` that is neither
  # a flag nor a flag's value, with any ?query stripped.
  local a skip=0 p=""
  shift
  for a in "$@"; do
    if [ "$skip" = 1 ]; then skip=0; continue; fi
    case "$a" in
      --hostname|--jq|-H|-f|-F|--method|-X) skip=1 ;;
      -*) ;;
      *) p="$a"; break ;;
    esac
  done
  printf '%s' "${p%%\?*}"
}

_events_serve() {
  # _events_serve <name> <path> "$@" → the GH_STUB_EVENTS_DIR answer (#712).
  local name="$1" path="$2" d rc; shift 2
  d="${GH_STUB_EVENTS_DIR:-}"
  [ -n "$d" ] || _assert_fail "new-verb call with GH_STUB_EVENTS_DIR unset: $path"
  if [ "$name" != user ] && ! _has_flag --paginate -- "$@"; then
    _assert_fail "api: $path without --paginate"
  fi
  [ -f "$d/$name.json" ] || _assert_fail "api: no $name.json for $path"
  cat "$d/$name.json"
  [ -f "$d/$name.err" ] && cat "$d/$name.err" >&2
  rc=$(cat "$d/$name.rc" 2>/dev/null || echo 0)
  exit "$rc"
}

_run_jq() {
  # _run_jq <json> "$@"  → apply the caller's --jq filter to <json> (gh's built-in jq)
  local json="$1"; shift
  local filter="" prev="" a
  for a in "$@"; do [ "$prev" = "--jq" ] && filter="$a"; prev="$a"; done
  [ -n "$filter" ] || _assert_fail "missing --jq: $*"
  printf '%s' "$json" | jq -r "$filter"
}

_issue_json() {
  local comments body labels
  case "${GH_STUB_CASE:-standard}" in
    nocomments) comments='[]' ;;
    *) comments='[{"author": {"login": "bob"}, "createdAt": "2026-05-12T08:14:22Z", "body": "First comment."}]' ;;
  esac
  # #537: per-test payload knobs — JSON-encoded string / array, verbatim.
  [ -n "${GH_STUB_COMMENTS_JSON:-}" ] && comments="$GH_STUB_COMMENTS_JSON"
  body='"Body line one.\n\nBody line two."'
  [ -n "${GH_STUB_BODY_JSON:-}" ] && body="$GH_STUB_BODY_JSON"
  # #561: same shape, default-off — see the header note on why the defaults are
  # deliberately non-`tier:*`.
  labels='[{"name": "bug"}, {"name": "performance"}]'
  [ -n "${GH_STUB_LABELS_JSON:-}" ] && labels="$GH_STUB_LABELS_JSON"
  # #885: issue/github.sh state-class reads state and stateReason.
  local reason=null number=676
  [ -n "${GH_STUB_STATE_REASON:-}" ] && reason="\"$GH_STUB_STATE_REASON\""
  [[ "${1:-}" =~ ^[0-9]+$ ]] && number="$1"
  cat <<JSON
{
  "number": $number,
  "title": "Demo issue title",
  "state": "${GH_STUB_ISSUE_STATE:-OPEN}",
  "stateReason": $reason,
  "author": {"login": "alice"},
  "labels": $labels,
  "url": "https://github.com/gnuradio/volk/issues/676",
  "body": $body,
  "comments": $comments
}
JSON
}

sub="${1:-}"
sub2="${2:-}"

# `gh issue create` — preserve prior behavior (argv log, URL, fail case).
if [ "$sub" = "issue" ] && [ "$sub2" = "create" ]; then
  [ -n "${GH_STUB_ARGS_LOG:-}" ] && printf '%s\n' "$*" >> "$GH_STUB_ARGS_LOG"
  case "${GH_STUB_CASE:-}" in
    fail) echo "stub-gh: simulated create failure" >&2; exit 1 ;;
    *)    printf '%s\n' "${GH_STUB_CREATE_URL:-https://github.com/gnuradio/volk/issues/85}" ;;
  esac
  exit 0
fi

case "$sub $sub2" in
  "issue view")
    _argv_log "$@"
    num="${3:-}"
    [ -n "$num" ] || _assert_fail "issue view: missing issue number"
    _has_flag --repo -- "$@" || _assert_fail "issue view: missing --repo"
    _has_flag --json -- "$@" || _assert_fail "issue view: missing --json"
    case "$num" in
      404) echo "gh: HTTP 404: Not Found (issue $num)" >&2; exit 1 ;;
      401) echo "gh: HTTP 401: Bad credentials" >&2; exit 1 ;;
    esac
    case "${GH_STUB_CASE:-standard}" in
      fail)  echo "stub-gh: simulated failure" >&2; exit 1 ;;
      noisy) echo "stub-gh: A new release of gh is available: 2.40.0 → 2.50.0" >&2 ;;
    esac
    _issue_json "$num"
    ;;

  "issue list")
    # issue/github.sh state-list (#703): every issue, the fields it classifies;
    # issue-list (#706): every issue with the fields `wbs init` imports. With
    # GH_STUB_ISSUE_LIST_UNKNOWN_FIELD=1 an issue-list call answers as a gh
    # older than 2.95 does (measured with 2.60: exit 1, this stderr), so the
    # GraphQL fallback runs.
    [ -n "${GH_STUB_ARGS_LOG:-}" ] && printf '%s\n' "$*" >> "$GH_STUB_ARGS_LOG"
    _pair() {  # _pair <flag> <value> -- "$@": <flag> is followed by <value>
      local f="$1" v="$2" prev="" a; shift 3
      for a in "$@"; do [ "$prev" = "$f" ] && [ "$a" = "$v" ] && return 0; prev="$a"; done
      return 1
    }
    _has_flag --repo -- "$@" || _assert_fail "issue list: missing --repo"
    _pair --state all -- "$@" || _assert_fail "issue list: want --state all: $*"
    _pair --limit 5000 -- "$@" || _assert_fail "issue list: want --limit 5000: $*"
    _il_fields=number,title,body,state,stateReason,createdAt,closedAt,milestone,labels,issueType,parent,blockedBy,url
    if _pair --json "$_il_fields" -- "$@"; then
      if [ "${GH_STUB_ISSUE_LIST_UNKNOWN_FIELD:-}" = 1 ]; then
        printf '%s\n' 'Unknown JSON field: "issueType"' 'Available fields:' '  assignees' >&2
        exit 1
      fi
    else
      _pair --json number,state,stateReason,labels -- "$@" \
        || _assert_fail "issue list: want --json number,state,stateReason,labels or the issue-list set: $*"
    fi
    case "${GH_STUB_CASE:-standard}" in
      fail) echo "gh: HTTP 401: Bad credentials" >&2; exit 1 ;;
    esac
    [ -n "${GH_STUB_ISSUE_LIST_FILE:-}" ] || _assert_fail "issue list: GH_STUB_ISSUE_LIST_FILE unset"
    cat "$GH_STUB_ISSUE_LIST_FILE"
    ;;

  "issue edit")
    num="${3:-}"
    [ -n "$num" ] || _assert_fail "issue edit: missing issue number"
    _has_flag --repo -- "$@" || _assert_fail "issue edit: missing --repo"
    _has_flag --add-label -- "$@" || _assert_fail "issue edit: missing --add-label"
    # #87: log the invocation (parity with `issue create`) so a test can assert
    # whether the label step ran at all, and simulate labels that are absent
    # from the repo so the fail-safe-skip path is observable.
    [ -n "${GH_STUB_ARGS_LOG:-}" ] && printf '%s\n' "$*" >> "$GH_STUB_ARGS_LOG"
    _argv_log "$@"
    if [ -n "${GH_STUB_EDIT_FAIL:-}" ]; then
      echo "gh: HTTP ${GH_STUB_EDIT_FAIL}: Resource not accessible by integration" >&2
      exit 1
    fi
    if [ -n "${GH_STUB_MISSING_LABEL:-}" ]; then
      _prev=""
      for _a in "$@"; do
        if [ "$_prev" = "--add-label" ]; then
          for _m in ${GH_STUB_MISSING_LABEL}; do
            [ "$_a" = "$_m" ] && { echo "gh: could not add label: '$_a' not found" >&2; exit 1; }
          done
        fi
        _prev="$_a"
      done
    fi
    exit 0
    ;;

  "label list")
    # issue/github.sh's label-existence check (#710): --search narrows
    # server-side, fuzzily, so the stub answers with every repo label.
    _argv_log "$@"
    _has_flag --repo -- "$@" || _assert_fail "label list: missing --repo"
    _has_flag --search -- "$@" || _assert_fail "label list: missing --search"
    _has_flag name -- "$@" || _assert_fail "label list: want --json name: $*"
    if [ "${GH_STUB_LABEL_LIST_FAIL:-}" = 1 ]; then
      echo "gh: HTTP 401: Bad credentials" >&2
      exit 1
    fi
    printf '%s\n' "${GH_STUB_REPO_LABELS:-[]}"
    ;;

  "pr view")
    _has_flag --json -- "$@" || _assert_fail "pr view: missing --json"
    # code/github.sh mr-checks (#782): the raw rollup; the backend runs its own jq.
    if _has_flag headRefOid,state,statusCheckRollup -- "$@"; then
      [ -z "${GH_STUB_PR_CHECKS_LOG:-}" ] || echo pr-checks >> "$GH_STUB_PR_CHECKS_LOG"
      [ -z "${GH_STUB_PR_CHECKS_SLEEP:-}" ] || exec sleep "$GH_STUB_PR_CHECKS_SLEEP"
      if [ "${GH_STUB_PR_CHECKS_RC:-0}" != 0 ]; then
        echo "stub: forced failure" >&2
        exit "$GH_STUB_PR_CHECKS_RC"
      fi
      [ -n "${GH_STUB_PR_CHECKS_FILE:-}" ] || _assert_fail "pr view: GH_STUB_PR_CHECKS_FILE unset"
      cat "$GH_STUB_PR_CHECKS_FILE"
      exit 0
    fi
    # code/github.sh mr-view (#885): the raw body; the backend runs its own jq.
    if _has_flag headRefOid,state,statusCheckRollup,isDraft,baseRefName,mergeable,mergeStateStatus,autoMergeRequest,closingIssuesReferences,commits,title,number,mergeCommit -- "$@"; then
      [ -n "${GH_STUB_PR_VIEW_FILE:-}" ] || _assert_fail "pr view: GH_STUB_PR_VIEW_FILE unset"
      cat "$GH_STUB_PR_VIEW_FILE"
      exit 0
    fi
    # gh runs --jq internally; the stub returns the already-filtered output.
    if _has_flag state -- "$@"; then
      echo "open"
    elif _has_flag comments,reviews -- "$@"; then
      # code/github.sh mr-comments (#592): raw forge JSON through the
      # caller's own --jq, as gh does, so the stub models gh rather than
      # the caller's internal framing.
      _run_jq '{"comments":[{"author":{"login":"bob"},"createdAt":"2026-05-12T08:14:22Z","body":"First comment."}],"reviews":[]}' "$@"
    else
      _assert_fail "pr view: unexpected --json selection: $*"
    fi
    ;;

  "pr merge")
    if [ -n "${GH_STUB_PR_MERGE_LOG:-}" ]; then
      _line=""
      for _a in "$@"; do _line+="[$_a] "; done
      printf '%s\n' "${_line% }" >> "$GH_STUB_PR_MERGE_LOG"
      if [ -t 0 ]; then _in=tty; else _in=notty; fi
      printf 'GH_PROMPT_DISABLED=%s stdin=%s\n' "${GH_PROMPT_DISABLED:-}" "$_in" >> "$GH_STUB_PR_MERGE_LOG"
    fi
    if [ "${GH_STUB_PR_MERGE_RC:-0}" != 0 ]; then
      printf '%s\n' "${GH_STUB_PR_MERGE_ERR:-stub: forced merge failure}" >&2
      exit "$GH_STUB_PR_MERGE_RC"
    fi
    exit 0
    ;;

  "pr create")
    printf '%s\n' "${GH_STUB_CREATE_URL:-https://github.com/foo/bar/pull/7}"
    ;;

  "pr list")
    # code/github.sh merged-pr-head: --json number --jq length
    echo "0"
    ;;

  "api graphql")
    # code/github.sh issue-mrs (#704): one recorded response per call.
    _api_log "$@"
    _q=0
    for _a in "$@"; do case "$_a" in query=?*) _q=1 ;; esac; done
    [ "$_q" = 1 ] || _assert_fail "api graphql: missing -f query=...: $*"
    [ -n "${GH_STUB_GRAPHQL_DIR:-}" ] || _assert_fail "api graphql: GH_STUB_GRAPHQL_DIR unset"
    _cnt="${GH_STUB_GRAPHQL_COUNT:-$GH_STUB_GRAPHQL_DIR/count}"
    _k=$(( $(cat "$_cnt" 2>/dev/null || echo 0) + 1 ))
    printf '%s\n' "$_k" > "$_cnt"
    if [ -n "${GH_STUB_ARGS_LOG:-}" ]; then
      _line=""
      for _a in "$@"; do _line+="[$_a] "; done
      printf '%s\n' "${_line% }" >> "$GH_STUB_ARGS_LOG"
    fi
    [ -f "$GH_STUB_GRAPHQL_DIR/$_k.json" ] || _assert_fail "api graphql: unexpected call $_k (no $_k.json)"
    cat "$GH_STUB_GRAPHQL_DIR/$_k.json"
    [ -f "$GH_STUB_GRAPHQL_DIR/$_k.err" ] && cat "$GH_STUB_GRAPHQL_DIR/$_k.err" >&2
    exit "$(cat "$GH_STUB_GRAPHQL_DIR/$_k.rc" 2>/dev/null || echo 0)"
    ;;

  "api "*)
    # code/github.sh mr-comments (#592): `gh api … repos/<r>/pulls/<n>/comments…`
    # → no inline comments, through the caller's --jq.
    # code/github.sh branch-exists: `gh api repos/<repo>/branches/<branch>`
    # and `gh api repos/<repo>` → {}. #712: any other path fails (exit 3).
    _api_log "$@"
    _path=$(_api_path "$@")
    if [[ "$_path" =~ ^repos/[^/]+/[^/]+/pulls/[^/]+/comments$ ]]; then
      _run_jq '[]' "$@"
    elif [[ "$_path" =~ ^repos/[^/]+/[^/]+/branches/.+$ ]] || [[ "$_path" =~ ^repos/[^/]+/[^/]+$ ]]; then
      echo "{}"
    elif [[ "$_path" =~ ^repos/[^/]+/[^/]+/issues/[^/]+/(events|comments)$ ]]; then
      _events_serve "${BASH_REMATCH[1]}" "$_path" "$@"
    elif [ "$_path" = user ]; then
      _events_serve user "$_path" "$@"
    else
      _assert_fail "api: unknown path $_path"
    fi
    ;;

  *)
    _assert_fail "unknown subcommand: '$sub $sub2'"
    ;;
esac
