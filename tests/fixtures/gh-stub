#!/usr/bin/env bash
# Verb-aware stub `gh` for tests (#90). It asserts the subcommand and required
# flags and returns per-case payloads, so a wrong subcommand/flag/repo in a
# backend exits non-zero (exit 3) — the regression net for the §9 github
# contract suite. Wrong invocations no longer pass silently.
#
# Knobs (unchanged from the pre-#90 stub):
#   GH_STUB_CASE   standard | nocomments | fail | noisy   (issue-view payload)
#   GH_STUB_CREATE_URL   URL printed by `gh issue create` (default …/issues/85)
#   GH_STUB_ARGS_LOG     if set, `gh issue create` appends its argv here (#89)
#   GH_STUB_BODY_JSON     if set, issue-view body — a JSON-encoded STRING (#537)
#   GH_STUB_COMMENTS_JSON if set, issue-view comments — a JSON array (#537)
#   GH_STUB_LABELS_JSON   if set, issue-view labels — a JSON array (#561)
#
# #561: the DEFAULT label set below (`bug`, `performance`) is deliberately
# non-`tier:*`-shaped. pull.sh's label channel classifies only `tier:*` labels
# and silently ignores the rest, so every suite that loads this stub stays green
# without opting in. Changing either default to a `tier:*` name would inject
# warns (or dies) into every one of those suites — pick a non-`tier:` name.
#
# Contract-suite HTTP simulation (number-driven, used by backend-github.bats):
#   issue number 404 → "HTTP 404" on stderr, exit 1
#   issue number 401 → "HTTP 401" on stderr, exit 1

set -u

# exit 3 = stub assertion failure (distinct from a simulated gh failure, exit 1).
_assert_fail() { echo "stub-gh: $*" >&2; exit 3; }

_has_flag() {
  # _has_flag <flag> -- "$@"  → 0 if <flag> appears as a standalone arg
  local want="$1"; shift; shift
  local a
  for a in "$@"; do [ "$a" = "$want" ] && return 0; done
  return 1
}

_issue_json() {
  local comments body labels
  case "${GH_STUB_CASE:-standard}" in
    nocomments) comments='[]' ;;
    *) comments='[{"author": {"login": "bob"}, "createdAt": "2026-05-12T08:14:22Z", "body": "First comment."}]' ;;
  esac
  # #537: per-test payload knobs — JSON-encoded string / array, verbatim.
  [ -n "${GH_STUB_COMMENTS_JSON:-}" ] && comments="$GH_STUB_COMMENTS_JSON"
  body='"Body line one.\n\nBody line two."'
  [ -n "${GH_STUB_BODY_JSON:-}" ] && body="$GH_STUB_BODY_JSON"
  # #561: same shape, default-off — see the header note on why the defaults are
  # deliberately non-`tier:*`.
  labels='[{"name": "bug"}, {"name": "performance"}]'
  [ -n "${GH_STUB_LABELS_JSON:-}" ] && labels="$GH_STUB_LABELS_JSON"
  cat <<JSON
{
  "title": "Demo issue title",
  "state": "OPEN",
  "author": {"login": "alice"},
  "labels": $labels,
  "url": "https://github.com/gnuradio/volk/issues/676",
  "body": $body,
  "comments": $comments
}
JSON
}

sub="${1:-}"
sub2="${2:-}"

# `gh issue create` — preserve prior behavior (argv log, URL, fail case).
if [ "$sub" = "issue" ] && [ "$sub2" = "create" ]; then
  [ -n "${GH_STUB_ARGS_LOG:-}" ] && printf '%s\n' "$*" >> "$GH_STUB_ARGS_LOG"
  case "${GH_STUB_CASE:-}" in
    fail) echo "stub-gh: simulated create failure" >&2; exit 1 ;;
    *)    printf '%s\n' "${GH_STUB_CREATE_URL:-https://github.com/gnuradio/volk/issues/85}" ;;
  esac
  exit 0
fi

case "$sub $sub2" in
  "issue view")
    num="${3:-}"
    [ -n "$num" ] || _assert_fail "issue view: missing issue number"
    _has_flag --repo -- "$@" || _assert_fail "issue view: missing --repo"
    _has_flag --json -- "$@" || _assert_fail "issue view: missing --json"
    case "$num" in
      404) echo "gh: HTTP 404: Not Found (issue $num)" >&2; exit 1 ;;
      401) echo "gh: HTTP 401: Bad credentials" >&2; exit 1 ;;
    esac
    case "${GH_STUB_CASE:-standard}" in
      fail)  echo "stub-gh: simulated failure" >&2; exit 1 ;;
      noisy) echo "stub-gh: A new release of gh is available: 2.40.0 → 2.50.0" >&2 ;;
    esac
    _issue_json
    ;;

  "issue edit")
    num="${3:-}"
    [ -n "$num" ] || _assert_fail "issue edit: missing issue number"
    _has_flag --repo -- "$@" || _assert_fail "issue edit: missing --repo"
    _has_flag --add-label -- "$@" || _assert_fail "issue edit: missing --add-label"
    # #87: log the invocation (parity with `issue create`) so a test can assert
    # whether the label step ran at all, and simulate labels that are absent
    # from the repo so the fail-safe-skip path is observable.
    [ -n "${GH_STUB_ARGS_LOG:-}" ] && printf '%s\n' "$*" >> "$GH_STUB_ARGS_LOG"
    if [ -n "${GH_STUB_MISSING_LABEL:-}" ]; then
      _prev=""
      for _a in "$@"; do
        if [ "$_prev" = "--add-label" ]; then
          for _m in ${GH_STUB_MISSING_LABEL}; do
            [ "$_a" = "$_m" ] && { echo "gh: could not add label: '$_a' not found" >&2; exit 1; }
          done
        fi
        _prev="$_a"
      done
    fi
    exit 0
    ;;

  "pr view")
    _has_flag --json -- "$@" || _assert_fail "pr view: missing --json"
    # gh runs --jq internally; the stub returns the already-filtered output.
    if _has_flag state -- "$@"; then
      echo "open"
    elif _has_flag comments -- "$@"; then
      printf '## Comments (1)\n\n### @bob · 2026-05-12\n\nFirst comment.\n'
    else
      _assert_fail "pr view: unexpected --json selection: $*"
    fi
    ;;

  "pr merge") exit 0 ;;

  "pr create")
    printf '%s\n' "${GH_STUB_CREATE_URL:-https://github.com/foo/bar/pull/7}"
    ;;

  "pr list")
    # code/github.sh merged-pr-head: --json number --jq length
    echo "0"
    ;;

  "api "*)
    # code/github.sh branch-exists: `gh api repos/<repo>/branches/<branch>`
    echo "{}"
    ;;

  *)
    _assert_fail "unknown subcommand: '$sub $sub2'"
    ;;
esac
