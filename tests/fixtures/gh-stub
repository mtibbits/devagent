#!/usr/bin/env bash
# Stub `gh` for tests. Honors GH_STUB_CASE env var.
# Supported: standard, nocomments, fail, noisy.
# `gh issue create` returns GH_STUB_CREATE_URL (default …/issues/85); see below.

# `gh issue create` prints the new issue's URL to stdout (real gh behavior).
# Override the URL via GH_STUB_CREATE_URL; GH_STUB_CASE=fail simulates failure.
if [ "${1:-}" = "issue" ] && [ "${2:-}" = "create" ]; then
  # Opt-in argv capture so tests can assert forwarded flags (e.g. --label) (#89).
  [ -n "${GH_STUB_ARGS_LOG:-}" ] && printf '%s\n' "$*" >> "$GH_STUB_ARGS_LOG"
  case "$GH_STUB_CASE" in
    fail) echo "stub-gh: simulated create failure" >&2; exit 1 ;;
    *)    printf '%s\n' "${GH_STUB_CREATE_URL:-https://github.com/gnuradio/volk/issues/85}" ;;
  esac
  exit 0
fi

# #86: emit a notice on stderr (like gh's update-nag/deprecation warnings) and
# otherwise behave as the standard success case, so tests can prove the backend
# keeps gh's stderr out of the JSON it pipes to jq.
if [ "${GH_STUB_CASE:-}" = "noisy" ]; then
  echo "stub-gh: A new release of gh is available: 2.40.0 → 2.50.0" >&2
  GH_STUB_CASE="standard"
fi

case "$GH_STUB_CASE" in
  fail)
    echo "stub-gh: simulated failure" >&2
    exit 1
    ;;
  nocomments)
    cat <<'JSON'
{
  "title": "Demo issue title",
  "state": "OPEN",
  "author": {"login": "alice"},
  "labels": [{"name": "bug"}, {"name": "performance"}],
  "url": "https://github.com/gnuradio/volk/issues/676",
  "body": "Body line one.\n\nBody line two.",
  "comments": []
}
JSON
    ;;
  *)
    cat <<'JSON'
{
  "title": "Demo issue title",
  "state": "OPEN",
  "author": {"login": "alice"},
  "labels": [{"name": "bug"}, {"name": "performance"}],
  "url": "https://github.com/gnuradio/volk/issues/676",
  "body": "Body line one.\n\nBody line two.",
  "comments": [
    {"author": {"login": "bob"}, "createdAt": "2026-05-12T08:14:22Z", "body": "First comment."}
  ]
}
JSON
    ;;
esac
