[defaults]
checklist_template = "standard"  # project default; a per-issue `tier:` key overrides — legal names live in the spec §6.3 tier table (#537)
ship_as_draft = false
# git_guard (#352): opt-in backstop. When true, the plugin's PreToolUse Bash hook
# (hooks/git-guard.sh) DENIES reflexive destructive git on a DIRTY tree — `git
# checkout … -- <path>`, `git restore <path>`, stash-creating `git stash`/`push`/
# `save`, and `git clean -f` — so an agentic run can't silently wipe uncommitted
# work. `git stash pop|apply` and a clean tree are always allowed. Override one
# call with a `DEVAGENT_GIT_GUARD_OVERRIDE=1` prefix. Default off; fail-open (a
# guard error never blocks a call). `/devagent:init` offers to enable it.
# #433: PER-PROJECT — a `[project.<name>] git_guard` value (true or false) wins
# over this [defaults] value for that project (resolved via the active project),
# so you can guard one risky project without enabling it everywhere. Must be a
# LITERALLY BARE line (no trailing comment) or the hook's gate won't see it.
# git_guard = false

# phase_breaks: an --auto/--through chain stops before each named step with a
# PHASE BREAK line, so the next phase starts in a fresh session (/clear, then the
# printed Resume command). A single session re-reads its whole history on every
# call; fresh sessions at implement, quality and updatewbs cut Issue-660's
# main-session cost ~56%. Unset, the default breaks before implement and quality,
# and before updatewbs unless the active revision's mergemr row is [x], or [-]
# because ship was [-] (no PR), so a merged chain runs on through cleanup. No
# mergemr row (older than #899) or an abandoned PR (mergemr [-] after a real
# ship) keeps that break. Space-separated step names; "" disables; `--no-breaks`
# skips one chain.
# A value you set is honoured as written: the line below keeps the break before
# updatewbs. A [project.<name>] phase_breaks (above its first subtable) wins
# over this value.
# phase_breaks = "implement quality updatewbs"
# session_rehydrate (#456): print the active issue and its next step at session
# start, so a fresh session resumes without /devagent:catchup. Pairs with
# phase_breaks. Default off; must be a LITERALLY BARE line, like git_guard.
# session_rehydrate = true
# ci_gate (#782): what the MR's CI status does after ship. "report" (default):
# every next call prints one CI line, and mergetoall requires green. "block": a
# pending CI also holds the post-ship step (nothing marked) and a red one marks it
# [!]. "off": no CI read at all. A [project.<name>] ci_gate wins over this value.
# ci_gate does not apply to step 20 (mergemr), which always reads CI.
# ci_gate = "report"
# merge_method / merge_checks (#885): how step 20 (mergemr) merges the PR when
# permissions.merge_mr = true. merge_method: "squash" (default), "merge" or
# "rebase". merge_checks: "required" (default) merges only on green CI and stops
# [!] when the PR has no checks; a repo without CI sets merge_checks = "if-present".
# A [project.<name>] value wins; any other value stops step 20 on every run.
# merge_method = "squash"
# merge_checks = "required"
# required_checks / required_checks_paths (#1097): set per project under
# [project.<name>], never here: there is no [defaults] layer, and either key here
# stops step 20. required_checks names the CI checks step 20 merges only on
# success; required_checks_paths lists more paths (besides .github/workflows/)
# whose change makes a PR self-certifying, an operator-only stop. Set them on every
# host that runs step 20; docs/configuration.md "Required CI checks" has the rest.
# The commented sample is in [project.{{PROJECT}}] below.

# The no-progress watchdog (#932): a launcher asks `scripts/watchdog.sh check
# <project> <issue>` whether an unattended session made progress; these keys are
# its limits (spec §7.3; docs/configuration.md "Watchdog limits"). Integer
# SECONDS, 1 to 604800; the values shown are the shipped ones. An attended
# session uses only the maximum, for step 13's analyze_silent_secs (below).
# /devagent:doctor checks them, and fails any other key that starts
# `watchdog_`, so a misspelt key cannot silently mean the default.
# watchdog_no_progress_secs: no progress for this long reads `stalled`. A
#   [project.<name>] value wins. Keep it at 840 or more on a project whose step
#   13 runs the static analyzer (its phases can be silent for about that long).
# watchdog_telemetry_secs: the "may take longer than … s" of the wrapping line
#   next prints in an unattended session, and the gap above which the long-run
#   wrapper logs a `quiet` line. A [project.<name>] value wins.
# watchdog_silent_max_secs: the longest silent window a session may declare
#   (`--silent`). [defaults] ONLY: a project-level key is never read and doctor
#   fails it.
# watchdog_no_progress_secs = 1200
# watchdog_telemetry_secs = 180
# watchdog_silent_max_secs = 3600

# Shared WORKFLOW pothole register (#611): one absolute path, read by every
# project as a union with the plugin seed and the project's own
# <devdoc>/templates/potholes.md. Global table; a [project.<name>.paths]
# potholes_workflow overrides it per project. Optional per-project
# potholes_domain_nouns = ["..."] lists words the shared layer refuses.
# [paths]                       # TOP-LEVEL table: keep it above the first [project.*] header
# potholes_workflow = "~/src/devDoc/templates/potholes.md"

# Durable transcript archive (#731): scripts/archive-transcripts.sh copies this
# machine's Claude Code transcripts (~/.claude/projects) into
# <transcripts_dir>/<host_id>/, append-only, and cleanup (step 24) runs it when
# transcripts_dir is set. cost-report --archive <transcripts_dir> reads it.
# The archive is as sensitive as ~/.claude: a transcript holds everything a
# session read. Keep it on private storage, never in a pushed repository (a
# transcripts_dir inside a git work tree, or inside ~/.claude/projects, is
# refused). On Windows POSIX modes do not apply; the archive inherits its
# parent's ACL, so pick a private parent.
# [archive]                     # TOP-LEVEL table: keep it above the first [project.*] header
# transcripts_dir = "/home/me/private/claude-transcripts"   # absolute (~ expands); required
# host_id = "laptop"            # [A-Za-z0-9._-]+, no "..", not "."; default the hostname (+ "-wsl" under WSL)
# exclude = ["*scratch*"]       # cwd-slug globs never archived (case-insensitive)

# Operator capacity (#743): what you can give devagent each week, in one shared
# table plus an optional table per project. scripts/capacity.sh reads it and a
# bare /devagent:doctor checks it; absent, forecasting is off (planned, #744).
# devagent does not know the subscription's limits: every value below is an example.
# Every number is declared, not measured: the token numbers are the operator's own,
# and relating the subscription's limits (which may count raw tokens) to them is yours.
# Every key except operator_hours_per_agent_hour is required once the table exists.
# Tokens are weighted input-token equivalents, the unit of the actuals ledger (#729).
# See docs/configuration.md "Capacity" for the types, ranges and rule strings.
# [capacity]                    # TOP-LEVEL table: keep it above the first [project.*] header
# operator_hours_per_week = 20          # example: hours of your attention a week
# lane_hours_per_week = 40              # example: hours one lane may run a week
# max_lanes = 3                         # example: lanes running at once, all projects together
# tokens_per_week = 500000000           # example: weekly token budget
# tokens_per_window = 60000000          # example: token budget of one rolling window
# windows_per_week = 10                 # example: windows used a week
# operator_hours_per_agent_hour = 0.25  # example: optional; your hours per agent hour

[project.{{PROJECT}}]
source_dir       = "{{SOURCE_DIR}}"
devdoc_dir       = "{{DEVDOC_DIR}}"
fork_first       = false
ship_as_draft    = false
default_baseline = "origin/{{DEFAULT_BRANCH}}"
branch_prefix_map = { bug = "fix", feature = "feat", docs = "docs", perf = "perf", chore = "chore" }
# required_checks (#1097): CI checks step 20 merges only on success (see [defaults] above).
# required_checks = ["Git Bash tagged files"]
# required_checks_paths = ["scripts/ci/"]
# Session isolation (#240): state is keyed by ISSUE, not by session — a
# session is identified by its issue pin. Two concurrent sessions on this
# project pin one issue each (export DEVAGENT_ACTIVE_ISSUE=Issue-N per
# worktree, e.g. via .claude/settings.local.json env, next to
# DEVAGENT_ACTIVE_PROJECT). A pinned session reads/writes its own
# [context.<issue>] table and NEVER touches the shared active_issue slot
# (pull/park skip it; switch refuses; cleanup GCs only its own table).
# Unpinned single-session behavior is unchanged and permanent — the shared
# slot is the default, not legacy; pre-existing state migrates
# adopt-on-first-write. Two UNpinned sessions on one project remain the #7
# advisory-warning case. Invalid pin ids fail loud (they would become TOML
# table names). Upgrade note: pre-#240 plugin code GCs a pinned session's
# live table on pull — update ALL long-lived sessions/caches before pinning.
#
# analyze: step-13 analyzer family (#55). Absent or "" = "cmake" (cppcheck via
# compile_commands.json + ASan/UBSan/TSan — the pre-#55 behavior). "shellcheck"
# = diff-scoped shellcheck --severity=warning over changed *.sh/*.bats/*.bash (plus
# untracked ones as whole files, #591); a finding is NEW only when its line is in
# a changed hunk vs baseline — or anywhere in an untracked file — so
# pre-existing repo noise never blocks; sanitizers are skipped (bats is the
# dynamic coverage). "none" = step 13 self-marks [-] with a logged reason (no
# manual skip needed). Any other value fails loud at analyze time.
# "shellcheck" needs shellcheck on PATH (step 13 stops without it); tested
# against shellcheck 0.9.0 or newer, not checked at run time — commands/analyze.md
# says where the version is recorded.
# analyze = "cmake"                      # cmake | shellcheck | none
#
# analyze_timeout: per-phase budget in SECONDS for the cmake analyze legs
# (configure / build / ctest) — bounds a hung build or test that would otherwise
# wedge an --auto chain forever (#351). Default 1800 (generous). Raise it for a
# large/slow ctest suite; a leg exceeding it fails step 13 (#117). Sanitizer +
# static build dirs are keyed per project+issue (build-<project>-<issue>[-<tag>]/)
# so concurrent chains sharing a source tree never collide; cleanup removes them.
# analyze_timeout = 1800
#
# analyze_silent_secs (#932): the silent window, in SECONDS, each analyze leg
# declares to the no-progress watchdog, so a leg that prints nothing for a while
# is not read as a stalled session. Unset, it is min(analyze_timeout,
# watchdog_silent_max_secs): 1800 with both at their shipped values. It must not
# exceed watchdog_silent_max_secs: above it, step 13 stops before any leg runs
# (attended too) and doctor fails the config. Also valid in [defaults].
# analyze_silent_secs = 1800

# suite_jobs: run bats test FILES N at a time in run-suite.sh (`bats --jobs N
# --no-parallelize-within-files`; tests inside one file still run in order).
# Default 1 = serial (an absent key means 1). Needs GNU parallel on PATH (the
# `parallel` package); run-suite dies loud without it. DEVAGENT_SUITE_JOBS
# overrides it for one run; the artifact's bats_jobs: line records what ran.
# Opt in only after auditing the suite at file granularity — README
# "Parallel bats" has the rules (#593).
# suite_jobs = 1
#
# evidence_platforms (#654): the platforms whose suite evidence THIS config's preship
# accepts. Every run-suite artifact records a `platform:` line of key=value pairs: the
# OS (os=), its release, the filesystem type of the measured tree (fs=), and whether
# chmod works there (modes=posix|no-op). An entry matches when each of its key=value
# pairs appears in that line; README "Running the test suite" lists every key. The
# example pins modes=posix, because an entry ignores the keys it does not name;
# modes=posix means the chmod probe found no no-op (it fails open), not proof that
# modes work. Set it in the config of whoever RUNS preship (on Windows, the Git Bash
# side, not the WSL clone's). With it, preship-evidence fails an artifact from any
# other platform (PLATFORM UNATTESTED), one with no platform: line, and an mr.md whose
# Evidence block lacks the artifact's platform: line. Without it, the platform is only
# echoed. A malformed value or an empty list stops the check. Declared or not, an
# mr.md drafted from the template must fill its platform: line, or delete it. (Editor
# note: this comment does not spell the release key: tests/generic-templates.bats #136
# refuses that token here.)
# (tests/suite-platform.bats runs the next line as written.)
# evidence_platforms = ["os=Linux fs=ext4 modes=posix"]

# --- Fork workflow (optional; uncomment + set to enable; defaults shown). ---
# fork_first above is the master switch; these tune the fork / all-prs plumbing.
# fork_only         = false              # never reference upstream (fork is the only remote)
# source_remote     = "origin"           # git remote that branches/PRs push to (e.g. "fork")
# all_prs_branch    = "dev/all-prs"      # REQUIRED to enable step-19 squash-merges (no default; unset = step 19 scaffolds pre-skipped [-])
# all_prs_auto_push = false              # push all_prs_branch after each merge-to-all
# all_prs_remote    = "origin"           # remote for all_prs_branch (defaults to source_remote)
# use_worktree      = false              # cut issue branches in a git worktree
# worktree_root     = "<source_dir>-wt"  # parent dir for per-issue worktrees
# include_coauthor  = true               # false strips Co-Authored-By from commits + PR bodies
# commit_autostage  = false              # true: step 12 auto-stages the issue's
#                                        #   in-scope FILES (one file path per line in
#                                        #   <issue-dir>/.devagent-scope) on a
#                                        #   dirty-but-nothing-staged tree instead of
#                                        #   the #25 die-loud guard. Stages ONLY those
#                                        #   exact files — never `git add -A`/`.`, and
#                                        #   directory / ':' pathspec / absolute / '..'
#                                        #   / glob entries are rejected. An absent/
#                                        #   empty/invalid manifest (or paths that
#                                        #   aren't dirty) falls back to die-loud, so
#                                        #   out-of-scope work is never committed.
#                                        #   When set, the implement step (#268)
#                                        #   auto-populates .devagent-scope from the
#                                        #   edited files (sentinel .devagent-scope.auto
#                                        #   marks it auto-generated; a hand-written
#                                        #   manifest is preserved, not clobbered).
# born_red          = false              # (#362) true: the implement step + commit.sh
#                                        #   run each NEW test at baseline_sha in an
#                                        #   ephemeral worktree and FLAG any that pass
#                                        #   there (never-red / vacuous). Writes
#                                        #   <issue-dir>/analysis/<date>-born-red.txt;
#                                        #   commit.sh dies on a FLAGGED verdict. Never
#                                        #   mutates your tree. Allowlist a legitimate
#                                        #   green-at-baseline in .devagent-born-red-allow
#                                        #   ("<file> :: <test> — <reason>"). bats+pytest.
#
# default_issue_source = "fork"         # (#1099) the tracker a flagless
#                                        #   `/devagent:pull <project> <N>` reads:
#                                        #   "origin" ([…issue_source]) or "fork"
#                                        #   ([…issue_source_fork]). Unset: the
#                                        #   project's only configured source, else
#                                        #   "origin". Any other value, or a source
#                                        #   with no backend, stops a flagless pull
#                                        #   and fails /devagent:doctor. --origin /
#                                        #   --fork override it for one pull;
#                                        #   /devagent:file's default target follows it.
#
# Fork-side tracker (Issue-Fork-NNN), when issues are filed on the fork:
# [project.{{PROJECT}}.issue_source_fork]
# backend    = "github"
# repo       = "you/your-fork"
# dir_prefix = "Issue-Fork-"          # register grammar (#613): issue ids must be Issue-N or Issue-Fork-N (POTHOLES_ISSUE_RE)

# Accepting a merge-forward without a full re-verification (#1125). With verify = "ci",
# `preship-verified-head.sh forward <project>` re-records verified_head (marked
# verified_by = forward) after a merge-forward that only re-applies git's own merge of
# the base, plus keep-both of a conflict in an append_only file. mergemr (step 20) then
# merges that head only on green CI, and rule 14 names this remedy when it applies.
# Absent, or verify = "preship": every merge-forward needs a full /devagent:preship.
# "The base" is default_baseline's ref: a project whose default_baseline does not
# track the PR's base should not set verify = "ci".
# [project.{{PROJECT}}.merge_forward]
# verify      = "ci"                # absent or "preship": today's behaviour
# append_only = ["CHANGELOG.md"]    # exact repo-relative file paths (no globs)

# Optional model-tier map (#150 surfacing, #151 dispatch consumer). next.sh prints one hint at dispatch and
# catchup shows the current step's tier; tier names (not model IDs) are
# forward-compatible. An absent table changes nothing; when set, next/catchup
# surface the tier and checking-class steps also consume it as their subagent
# dispatch model override (#151). Classes: thinking = steps 2 9 10 11 14, checking = 5 15 16 17, else default;
# a per-step override (numeric key) wins over its class.
# Enforcement differs by step: the checking class is fully enforced (all four
# dispatch), while of the thinking class only step 2 (draft) dispatches — for
# 9/10/11/14 the tier is an ADVISORY next/catchup hint, since a session cannot
# swap its own model.
# The portfolio's per-leaf `models` field reads thinking/checking/default only;
# numeric per-step keys are ignored there (#890).
# [project.{{PROJECT}}.step_models]
# default  = "sonnet"
# thinking = "opus"     # draft, implement, quality, document, draftmr
# checking = "fable"    # improve, review, redmr, preship
# "9"      = "fable"    # per-step override (implement) beats the class tier
#
# Per-issue override: a `.devagent-step-models` file in the issue directory
# beats this whole table — numeric per-step keys included. TWO forms:
#
#   BARE token (#291, legacy)      one token, e.g. `fable`. Pins the
#                                  CHECKING-class steps (5/15/16/17) only;
#                                  non-checking steps ignore it.
#   KEYED lines (#561)             one line per steered class, either or both,
#                                  covering CHECKING and THINKING:
#                                      checking: fable
#                                      thinking: sonnet
#                                  A class with no line falls through to this
#                                  table. Two lines for the same class fail loud.
#
# Both forms: the reserved token `inherit` stands the table down and inherits
# the session model. An empty or multi-token marker fails loud (like
# .devagent-baseline, #162) — never a silent fallback. The `default` class never
# reads the marker.
#
# pull.sh writes the keyed form at FIRST SCAFFOLD from the issue body's
# `## Workflow flags` keys `checking-model:` / `implementation-model:`, from the
# `tier: <model>-checking` compat shim, or from recognized `tier:*` forge labels
# (`tier:impl-<model>`, `tier:check-<model>`, `tier:<model>-checking`). Legal
# tokens: sonnet opus haiku fable inherit. Hand-editing the marker is the
# documented post-scaffold path; an existing marker is never stomped.
# Remove the marker at issue cleanup.

# Per-project capacity (#743), optional; needs the shared [capacity] table above.
# Priority (planned, #744): lanes go to the lowest priority number first, and
# ties go to the project holding fewer lanes, then by name. Tokens and operator
# hours beyond the reservations are shared by weight 1/priority. Default: 5.
# A paused project takes no capacity, and its reservations leave the pool sums.
# [project.{{PROJECT}}.capacity]
# priority = 5                          # example: integer >= 1; a lower number is a higher priority
# max_lanes = 2                         # example: this project's lane cap, at most capacity.max_lanes
# paused = false                        # example
# deadline = 2026-12-31                 # example: a TOML date or a quoted "YYYY-MM-DD"
# reserve_operator_hours_per_week = 4   # example: your hours set aside for this project
# reserve_tokens_per_week = 100000000   # example: tokens set aside for this project

# Per-project WORKFLOW override (#120): any checklist template resolves via
# the §12 registry — drop a checklist-<name>.md in <devdoc>/templates/ or pin
# an explicit path (quote the hyphenated key):
#   [project.{{PROJECT}}.paths]
#   "checklist-standard" = "templates/my-standard.md"   # devdoc-relative
# NB: an override path that does not exist falls through to the next layer
# with a warning on stderr. Custom-workflow authoring rules (gate step names, required
# steps, custom commands): see commands/template.md.
# Under a trust policy (spec §3.8, #713) these gates are read from policy.toml
# instead, for every project the policy scopes; nothing here can open them.
[project.{{PROJECT}}.permissions]
push_mr            = false
merge_mr           = false   # true: step 20 merges the PR at the verified head (#885; a forward-recorded head only on green CI, #1125); never prompts
merge_to_all_prs   = false   # step 19 mergetoall (merge_mr no longer gates it)
commit_devdoc      = false
transition_issue   = false   # every tracker transition (draft, ship, sync) writes only when true; fail-closed (#219, #710)

[project.{{PROJECT}}.issue_source]
backend = "{{ISSUE_BACKEND}}"
repo = "{{ISSUE_REPO}}"
dir_prefix = "Issue-"                  # must stay "Issue-" (or "Issue-Fork-" for a fork tracker): the pothole register cites issues as Issue-N / Issue-Fork-N only (#613)

[project.{{PROJECT}}.code_source]
backend = "{{CODE_BACKEND}}"
upstream = "{{CODE_UPSTREAM}}"
fork = "{{CODE_FORK}}"

[project.{{PROJECT}}.issue_workflow]   # the tracker state each transition writes: a label on
on_draft_start = "In Progress"         # GitHub/GitLab, a status on JIRA; it must already exist
on_ship        = "In Review"           # (devagent never creates one; doctor warns when missing)
on_merge       = "Done"
# not_planned_resolutions = ["Won't Do"]   # jira: wbs update reads these done resolutions as [-] (#703)
# wbs update reads an open issue carrying the on_draft_start label as [~] (#703, #710).
# A per-stage label override: [project.{{PROJECT}}.github_labels] (or gitlab_labels)
# keyed on_draft_start / on_ship / on_merge.
