[defaults]
checklist_template = "standard"  # project default; a per-issue `tier:` key overrides — legal names live in the spec §6.3 tier table (#537)
ship_as_draft = false
# git_guard (#352): opt-in backstop. When true, the plugin's PreToolUse Bash hook
# (hooks/git-guard.sh) DENIES reflexive destructive git on a DIRTY tree — `git
# checkout … -- <path>`, `git restore <path>`, stash-creating `git stash`/`push`/
# `save`, and `git clean -f` — so an agentic run can't silently wipe uncommitted
# work. `git stash pop|apply` and a clean tree are always allowed. Override one
# call with a `DEVAGENT_GIT_GUARD_OVERRIDE=1` prefix. Default off; fail-open (a
# guard error never blocks a call). `/devagent:init` offers to enable it.
# #433: PER-PROJECT — a `[project.<name>] git_guard` value (true or false) wins
# over this [defaults] value for that project (resolved via the active project),
# so you can guard one risky project without enabling it everywhere. Must be a
# LITERALLY BARE line (no trailing comment) or the hook's gate won't see it.
# git_guard = false

[project.{{PROJECT}}]
source_dir       = "{{SOURCE_DIR}}"
devdoc_dir       = "{{DEVDOC_DIR}}"
fork_first       = false
ship_as_draft    = false
default_baseline = "origin/{{DEFAULT_BRANCH}}"
branch_prefix_map = { bug = "fix", feature = "feat", docs = "docs", perf = "perf", chore = "chore" }
# Session isolation (#240): state is keyed by ISSUE, not by session — a
# session is identified by its issue pin. Two concurrent sessions on this
# project pin one issue each (export DEVAGENT_ACTIVE_ISSUE=Issue-N per
# worktree, e.g. via .claude/settings.local.json env, next to
# DEVAGENT_ACTIVE_PROJECT). A pinned session reads/writes its own
# [context.<issue>] table and NEVER touches the shared active_issue slot
# (pull/park skip it; switch refuses; cleanup GCs only its own table).
# Unpinned single-session behavior is unchanged and permanent — the shared
# slot is the default, not legacy; pre-existing state migrates
# adopt-on-first-write. Two UNpinned sessions on one project remain the #7
# advisory-warning case. Invalid pin ids fail loud (they would become TOML
# table names). Upgrade note: pre-#240 plugin code GCs a pinned session's
# live table on pull — update ALL long-lived sessions/caches before pinning.
#
# analyze: step-13 analyzer family (#55). Absent or "" = "cmake" (cppcheck via
# compile_commands.json + ASan/UBSan/TSan — the pre-#55 behavior). "shellcheck"
# = diff-scoped shellcheck --severity=warning over changed *.sh/*.bats/*.bash;
# a finding is NEW only when its line is in a changed hunk vs baseline, so
# pre-existing repo noise never blocks; sanitizers are skipped (bats is the
# dynamic coverage). "none" = step 11 self-marks [-] with a logged reason (no
# manual skip needed). Any other value fails loud at analyze time.
# analyze = "cmake"                      # cmake | shellcheck | none
#
# analyze_timeout: per-phase budget in SECONDS for the cmake analyze legs
# (configure / build / ctest) — bounds a hung build or test that would otherwise
# wedge an --auto chain forever (#351). Default 1800 (generous). Raise it for a
# large/slow ctest suite; a leg exceeding it fails step 11 (#117). Sanitizer +
# static build dirs are keyed per project+issue (build-<project>-<issue>[-<tag>]/)
# so concurrent chains sharing a source tree never collide; cleanup removes them.
# analyze_timeout = 1800

# --- Fork workflow (optional; uncomment + set to enable; defaults shown). ---
# fork_first above is the master switch; these tune the fork / all-prs plumbing.
# fork_only         = false              # never reference upstream (fork is the only remote)
# source_remote     = "origin"           # git remote that branches/PRs push to (e.g. "fork")
# all_prs_branch    = "dev/all-prs"      # REQUIRED to enable step-19 squash-merges (no default; unset = skip)
# all_prs_auto_push = false              # push all_prs_branch after each merge-to-all
# all_prs_remote    = "origin"           # remote for all_prs_branch (defaults to source_remote)
# use_worktree      = false              # cut issue branches in a git worktree
# worktree_root     = "<source_dir>-wt"  # parent dir for per-issue worktrees
# include_coauthor  = true               # false strips Co-Authored-By from commits + PR bodies
# commit_autostage  = false              # true: step 10 auto-stages the issue's
#                                        #   in-scope FILES (one file path per line in
#                                        #   <issue-dir>/.devagent-scope) on a
#                                        #   dirty-but-nothing-staged tree instead of
#                                        #   the #25 die-loud guard. Stages ONLY those
#                                        #   exact files — never `git add -A`/`.`, and
#                                        #   directory / ':' pathspec / absolute / '..'
#                                        #   / glob entries are rejected. An absent/
#                                        #   empty/invalid manifest (or paths that
#                                        #   aren't dirty) falls back to die-loud, so
#                                        #   out-of-scope work is never committed.
#                                        #   When set, the implement step (#268)
#                                        #   auto-populates .devagent-scope from the
#                                        #   edited files (sentinel .devagent-scope.auto
#                                        #   marks it auto-generated; a hand-written
#                                        #   manifest is preserved, not clobbered).
# born_red          = false              # (#362) true: the implement step + commit.sh
#                                        #   run each NEW test at baseline_sha in an
#                                        #   ephemeral worktree and FLAG any that pass
#                                        #   there (never-red / vacuous). Writes
#                                        #   <issue-dir>/analysis/<date>-born-red.txt;
#                                        #   commit.sh dies on a FLAGGED verdict. Never
#                                        #   mutates your tree. Allowlist a legitimate
#                                        #   green-at-baseline in .devagent-born-red-allow
#                                        #   ("<file> :: <test> — <reason>"). bats+pytest.
#
# Fork-side tracker (Issue-Fork-NNN), when issues are filed on the fork:
# [project.{{PROJECT}}.issue_source_fork]
# backend    = "github"
# repo       = "you/your-fork"
# dir_prefix = "Issue-Fork-"

# Optional model-tier map (#150 surfacing, #151 dispatch consumer). next.sh prints one hint at dispatch and
# catchup shows the current step's tier; tier names (not model IDs) are
# forward-compatible. An absent table changes nothing; when set, next/catchup
# surface the tier and checking-class steps also consume it as their subagent
# dispatch model override (#151). Classes: thinking = steps 1 7 8 9 12, checking = 3 13 14 21, else default;
# a per-step override (numeric key) wins over its class.
# [project.{{PROJECT}}.step_models]
# default  = "sonnet"
# thinking = "opus"     # draft, implement, quality, document, draftmr
# checking = "fable"    # improve, review, redmr, preship
# "7"      = "fable"    # per-step override (implement) beats the class tier
#
# Per-issue override (#291): a `.devagent-step-models` file in the issue
# directory holding ONE tier token (e.g. `fable`) pins the CHECKING-class
# steps (5/15/16/17) for that issue, beating this whole table — numeric
# per-step keys included. The reserved token `inherit` stands the table down
# and inherits the session model. An empty or multi-token marker fails loud
# (like .devagent-baseline, #162) — never a silent fallback. Non-checking
# steps ignore the marker. Remove the marker at issue cleanup.

# Per-project WORKFLOW override (#120): any checklist template resolves via
# the §12 registry — drop a checklist-<name>.md in <devdoc>/templates/ or pin
# an explicit path (quote the hyphenated key):
#   [project.{{PROJECT}}.paths]
#   "checklist-standard" = "templates/my-standard.md"   # devdoc-relative
# NB: an override path that does not exist falls through SILENTLY to the
# plugin default. Custom-workflow authoring rules (gate step names, required
# steps, custom commands): see commands/template.md.
[project.{{PROJECT}}.permissions]
push_mr            = false
merge_mr           = false
merge_to_all_prs   = false
commit_devdoc      = false
transition_issue   = false   # (#219) allow sync to fire the remote on_merge tracker transition; fail-closed

[project.{{PROJECT}}.issue_source]
backend = "{{ISSUE_BACKEND}}"
repo = "{{ISSUE_REPO}}"
dir_prefix = "Issue-"

[project.{{PROJECT}}.code_source]
backend = "{{CODE_BACKEND}}"
upstream = "{{CODE_UPSTREAM}}"
fork = "{{CODE_FORK}}"

[project.{{PROJECT}}.issue_workflow]
on_draft_start = "In Progress"
on_ship        = "In Review"
on_merge       = "Done"
