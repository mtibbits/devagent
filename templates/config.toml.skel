[defaults]
checklist_template = "standard"
ship_as_draft = false

[project.{{PROJECT}}]
source_dir       = "{{SOURCE_DIR}}"
devdoc_dir       = "{{DEVDOC_DIR}}"
fork_first       = false
ship_as_draft    = false
default_baseline = "origin/{{DEFAULT_BRANCH}}"
branch_prefix_map = { bug = "fix", feature = "feat", docs = "docs", perf = "perf", chore = "chore" }

# --- Fork workflow (optional; uncomment + set to enable; defaults shown). ---
# fork_first above is the master switch; these tune the fork / all-prs plumbing.
# fork_only         = false              # never reference upstream (fork is the only remote)
# source_remote     = "origin"           # git remote that branches/PRs push to (e.g. "fork")
# all_prs_branch    = "dev/all-prs"      # REQUIRED to enable step-16 squash-merges (no default; unset = skip)
# all_prs_auto_push = false              # push all_prs_branch after each merge-to-all
# all_prs_remote    = "origin"           # remote for all_prs_branch (defaults to source_remote)
# use_worktree      = false              # cut issue branches in a git worktree
# worktree_root     = "<source_dir>-wt"  # parent dir for per-issue worktrees
# include_coauthor  = true               # false strips Co-Authored-By from commits + PR bodies
# commit_autostage  = false              # true: step 10 auto-stages the issue's
#                                        #   in-scope FILES (one file path per line in
#                                        #   <issue-dir>/.devagent-scope) on a
#                                        #   dirty-but-nothing-staged tree instead of
#                                        #   the #25 die-loud guard. Stages ONLY those
#                                        #   exact files — never `git add -A`/`.`, and
#                                        #   directory / ':' pathspec / absolute / '..'
#                                        #   / glob entries are rejected. An absent/
#                                        #   empty/invalid manifest (or paths that
#                                        #   aren't dirty) falls back to die-loud, so
#                                        #   out-of-scope work is never committed.
#                                        #   When set, the implement step (#268)
#                                        #   auto-populates .devagent-scope from the
#                                        #   edited files (sentinel .devagent-scope.auto
#                                        #   marks it auto-generated; a hand-written
#                                        #   manifest is preserved, not clobbered).
#
# Fork-side tracker (Issue-Fork-NNN), when issues are filed on the fork:
# [project.{{PROJECT}}.issue_source_fork]
# backend    = "github"
# repo       = "you/your-fork"
# dir_prefix = "Issue-Fork-"

# Optional model-tier map (#150 surfacing, #151 dispatch consumer). next.sh prints one hint at dispatch and
# catchup shows the current step's tier; tier names (not model IDs) are
# forward-compatible. An absent table changes nothing; when set, next/catchup
# surface the tier and checking-class steps also consume it as their subagent
# dispatch model override (#151). Classes: thinking = steps 1 7 8 9 12, checking = 3 13 14, else default;
# a per-step override (numeric key) wins over its class.
# [project.{{PROJECT}}.step_models]
# default  = "sonnet"
# thinking = "opus"     # draft, implement, quality, document, draftmr
# checking = "fable"    # improve, review, redmr, preship
# "7"      = "fable"    # per-step override (implement) beats the class tier

# Per-project WORKFLOW override (#120): any checklist template resolves via
# the §12 registry — drop a checklist-<name>.md in <devdoc>/templates/ or pin
# an explicit path (quote the hyphenated key):
#   [project.{{PROJECT}}.paths]
#   "checklist-standard" = "templates/my-standard.md"   # devdoc-relative
# NB: an override path that does not exist falls through SILENTLY to the
# plugin default. Gates resolve step NAMES (absent => no gate): keep
# updatewbs/impact/lessonslearned/preship named if you want their gates;
# cleanup (20) is required. A custom step name needs its own /devagent:<name>
# command (operator-provided).
[project.{{PROJECT}}.permissions]
push_mr            = false
merge_mr           = false
merge_to_all_prs   = false
commit_devdoc      = false
transition_issue   = false   # (#219) allow sync to fire the remote on_merge tracker transition; fail-closed

[project.{{PROJECT}}.issue_source]
backend = "{{ISSUE_BACKEND}}"
repo = "{{ISSUE_REPO}}"
dir_prefix = "Issue-"

[project.{{PROJECT}}.code_source]
backend = "{{CODE_BACKEND}}"
upstream = "{{CODE_UPSTREAM}}"
fork = "{{CODE_FORK}}"

[project.{{PROJECT}}.issue_workflow]
on_draft_start = "In Progress"
on_ship        = "In Review"
on_merge       = "Done"
